{
  "manifest_version": 3,
  "name": "PaperIsHere",
  "version": "2.4.0",
  "description": "Typography-driven academic tool: Auto-rename PDFs via Crossref/Gemini, and find free PDFs via Unpaywall, Sci-Hub, and Libgen.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PaperIsHere Configuration",
    "default_icon": "icon48.png"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}